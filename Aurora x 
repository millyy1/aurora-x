
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aurora X | Conecte-se ao Extraordinário</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Poppins:wght@300;400;500;600;700&display=swap');

:root {
  --azul: #168cff;
  --roxo: #873cff;
  --fundo: #050713;
  --texto: #ffffff;
  --cinza: #a9b0c5;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  background: var(--fundo);
  color: var(--texto);
  font-family: 'Poppins', sans-serif;
  overflow-x: hidden;
}

header {
  position: fixed;
  top: 0;
  width: 100%;
  padding: 18px 8%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(5,7,19,.88);
  backdrop-filter: blur(15px);
  z-index: 1000;
  border-bottom: 1px solid rgba(90,130,255,.15);
}

.logo {
  font-family: 'Orbitron', sans-serif;
  font-size: 25px;
  font-weight: 800;
  letter-spacing: 2px;
}

.logo span {
  background: linear-gradient(90deg, var(--azul), var(--roxo));
  -webkit-background-clip: text;
  color: transparent;
}

nav {
  display: flex;
  gap: 30px;
}

nav a {
  text-decoration: none;
  color: white;
  font-size: 13px;
  transition: .3s;
}

nav a:hover {
  color: var(--azul);
}

.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 140px 20px 80px;
  background:
    radial-gradient(ellipse at 50% 55%, rgba(28,90,255,.20), transparent 55%),
    radial-gradient(ellipse at 80% 30%, rgba(125,40,255,.15), transparent 45%);
  position: relative;
}

.hero-content {
  max-width: 850px;
}

.tag {
  color: #80baff;
  letter-spacing: 5px;
  font-size: 12px;
  margin-bottom: 25px;
}

.hero h1 {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(40px, 8vw, 85px);
  line-height: 1.15;
  margin-bottom: 20px;
}

.hero h1 span {
  background: linear-gradient(90deg, #16a5ff, #9c54ff);
  -webkit-background-clip: text;
  color: transparent;
}

.hero p {
  color: var(--cinza);
  font-size: 16px;
  line-height: 1.8;
  max-width: 620px;
  margin: auto;
}

.btn {
  display: inline-block;
  margin-top: 35px;
  padding: 14px 32px;
  border-radius: 40px;
  color: white;
  text-decoration: none;
  background: linear-gradient(100deg, #087fff, #803cff);
  box-shadow: 0 0 25px rgba(35,120,255,.35);
  transition: .3s;
}

.btn:hover {
  transform: translateY(-4px);
  box-shadow: 0 0 35px rgba(110,70,255,.65);
}

section {
  padding: 100px 8%;
}

.section-title {
  text-align: center;
  margin-bottom: 55px;
}

.section-title h2 {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(25px, 4vw, 38px);
  margin-bottom: 15px;
}

.section-title p {
  color: var(--cinza);
  font-size: 14px;
}

.products {
  background: linear-gradient(180deg, #080b1a, #050713);
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 25px;
}

.product-card {
  background: linear-gradient(145deg, #111a32, #090d1b);
  border: 1px solid rgba(75,140,255,.2);
  border-radius: 20px;
  padding: 30px 22px;
  text-align: center;
  transition: .35s;
}

.product-card:hover {
  transform: translateY(-10px);
  border-color: var(--azul);
  box-shadow: 0 10px 35px rgba(20,110,255,.15);
}

.phone {
  height: 190px;
  width: 105px;
  margin: 0 auto 25px;
  border-radius: 22px;
  border: 4px solid #52617c;
  background:
    radial-gradient(circle at 70% 30%, #a85aff, transparent 25%),
    linear-gradient(145deg, #087bff, #161b49 65%, #9b37ff);
  box-shadow: 0 0 30px rgba(36,115,255,.25);
  position: relative;
}

.phone::before {
  content: "";
  position: absolute;
  top: 7px;
  left: 50%;
  transform: translateX(-50%);
  width: 28px;
  height: 5px;
  border-radius: 10px;
  background: #10131d;
}

.phone::after {
  content: "";
  position: absolute;
  top: 13px;
  left: 9px;
  width: 23px;
  height: 48px;
  border-radius: 12px;
  border: 2px solid rgba(255,255,255,.55);
}

.wave {
  background: linear-gradient(145deg, #12b5ff, #143d9c, #161b49);
}

.infinite {
  background: linear-gradient(145deg, #8e1c47, #3c102d, #d24c79);
}

.prime {
  background: linear-gradient(145deg, #397cff, #28145e, #a74cff);
}

.product-card h3 {
  font-family: 'Orbitron', sans-serif;
  font-size: 17px;
  margin-bottom: 10px;
}

.product-card .price {
  font-size: 24px;
  font-weight: 700;
  color: #72baff;
  margin: 18px 0;
}

.product-card ul {
  list-style: none;
  color: var(--cinza);
  font-size: 12px;
  line-height: 2.2;
}

.features {
  background: #080b19;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 20px;
}

.feature {
  padding: 28px;
  border-radius: 16px;
  background: #10172a;
  border: 1px solid rgba(100,140,255,.15);
}

.feature .symbol {
  font-size: 30px;
  margin-bottom: 15px;
}

.feature h3 {
  color: #76baff;
  margin-bottom: 10px;
}

.feature p {
  color: var(--cinza);
  font-size: 13px;
  line-height: 1.8;
}

.about {
  text-align: center;
  background:
    radial-gradient(ellipse at center, rgba(75,55,190,.13), transparent 65%);
}

.about-content {
  max-width: 850px;
  margin: auto;
}

.about-content p {
  color: var(--cinza);
  line-height: 2;
  font-size: 14px;
}

.values {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 18px;
  margin-top: 40px;
}

.value {
  padding: 25px;
  border-radius: 15px;
  background: rgba(30,55,110,.25);
}

.value h3 {
  color: #83baff;
  margin-bottom: 8px;
}

.team {
  background: #080b19;
}

.team-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 18px;
}

.member {
  background: #111a2d;
  padding: 25px 15px;
  border-radius: 15px;
  text-align: center;
  border: 1px solid rgba(90,140,255,.15);
}

.member h3 {
  font-size: 14px;
  margin-bottom: 8px;
}

.member p {
  color: #7eb9ff;
  font-size: 12px;
}

footer {
  padding: 45px 20px;
  text-align: center;
  background: #03050d;
  border-top: 1px solid rgba(90,130,255,.15);
}

footer .logo {
  margin-bottom: 12px;
}

footer p {
  color: var(--cinza);
  font-size: 12px;
  line-height: 2;
}

@media (max-width: 700px) {
  header {
    padding: 16px 5%;
  }

  .logo {
    font-size: 19px;
  }

  nav {
    gap: 12px;
  }

  nav a {
    font-size: 10px;
  }

  section {
    padding: 75px 6%;
  }

  .hero {
    min-height: 90vh;
  }
}

@media (max-width: 420px) {
  nav {
    gap: 8px;
  }

  nav a {
    font-size: 9px;
  }
}
</style>
</head>

